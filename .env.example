NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://transport:replace-me@localhost:5432/transport
AUTH_SERVICE_URL=http://localhost:3000
# Match the real authServiceCaney token contract. Never commit signing secrets.
JWT_ISSUER=
JWT_AUDIENCE=
# Use its RS256 public key (literal \n separators accepted), or its HS256 secret.
JWT_PUBLIC_KEY=
JWT_SECRET=
# Signs the public "share my trip" links (UC-TRA-12); at least 16 random characters.
SHARE_LINK_SECRET=
# Google Maps Platform key with the Routes API enabled (real driving routes and ETA). Without it the service uses straight-line estimates.
GOOGLE_MAPS_API_KEY=

# Swagger UI en /docs y OpenAPI en /docs/openapi.json (públicos, solo lectura). Pon false para ocultarlos.
DOCS_ENABLED=true
